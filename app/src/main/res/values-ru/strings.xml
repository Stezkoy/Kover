    <!-- Launcher -->
    <string name="launcher_title">Лаунчер</string>
    <string name="launcher_hint">Kover пишет метаданные и арт прямо в папку лаунчера.</string>
    <string name="launcher_howto">Как настроить</string>
    <string name="launcher_import_hint">ES-DE, NeoStation и Custom пишутся напрямую. Cocoon, Daijisho и iiSU — только через импорт; откройте их карточки для подробной инструкции.</string>
    <string name="launcher_import_subtitle">Импорт из ES-DE (без прямой синхронизации)</string>
    <string name="launcher_dir">Папка ES-DE</string>
